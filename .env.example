[TEMPLATE]
# ============================================================
# ApexHires Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
# Usage:
#   flutter run --dart-define-from-file=.env
#   flutter build web --dart-define-from-file=.env
# ============================================================

# ── Firebase (from Firebase Console → Project Settings) ──────

# Android
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=

# iOS
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=

# macOS (optional — leave empty if not targeting macOS)
FIREBASE_MACOS_API_KEY=
FIREBASE_MACOS_APP_ID=

# Web
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=

# Shared across all platforms
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_DOMAIN=apexhires.firebaseapp.com
FIREBASE_MEASUREMENT_ID=

# iOS Bundle ID
FIREBASE_IOS_BUNDLE_ID=com.apexhires.apexHires

# ── OneSignal (from https://onesignal.com) ───────────────────
# Push notification service. Leave empty to disable push.

ONESIGNAL_APP_ID=

# ── Supabase (from https://supabase.com) ─────────────────────
# File storage for avatars, resumes, and logos.
# Get keys from: Supabase Dashboard → Settings → API

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Push Notifications (Supabase Edge Function) ─────────────
# The OneSignal REST API key is stored as a Supabase secret,
# NOT in this file. Set it with:
#
#   supabase secrets set ONESIGNAL_REST_API_KEY=your_key_here
#   supabase secrets set ONESIGNAL_APP_ID=your_app_id_here
#
# Then deploy the Edge Function:
#
#   cd apex_hires
#   supabase functions deploy send-notification
